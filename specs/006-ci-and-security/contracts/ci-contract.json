{
  "$comment": "What the workflows and configuration must be. Asserted by scripts/check-ci-contract.sh. Spec: 006-ci-and-security.",
  "version_file": {
    "path": "VERSION",
    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
    "requirement": "FR-005a"
  },
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "triggers": [
        "pull_request",
        "push"
      ],
      "push_branches": [
        "main"
      ],
      "permissions": {
        "contents": "read"
      },
      "concurrency": {
        "group": true,
        "cancel_in_progress": true
      },
      "jobs": [
        "lint",
        "test-backend",
        "test-consumer",
        "test-mcp",
        "test-frontend",
        "test-hooks",
        "scan"
      ],
      "forbidden_permissions": [
        "packages",
        "id-token",
        "contents: write"
      ],
      "requirement": "FR-001, FR-002, FR-007"
    },
    {
      "path": ".github/workflows/release.yml",
      "triggers": [
        "push"
      ],
      "push_branches": [
        "main"
      ],
      "permissions": {
        "contents": "read"
      },
      "job_permissions": {
        "publish": {
          "contents": "read",
          "packages": "write"
        }
      },
      "concurrency": {
        "group": true,
        "cancel_in_progress": false
      },
      "jobs": [
        "preflight",
        "publish"
      ],
      "requirement": "FR-004, FR-005, FR-007",
      "$comment": "cancel_in_progress is false on purpose: cancelling a half-finished publish leaves some services on the new version and some on the old. `preflight` checks all three tags before any build for the same reason.",
      "paths": [
        "backend/**",
        "consumer/**",
        "frontend/**",
        "VERSION",
        ".github/workflows/release.yml"
      ]
    }
  ],
  "forbidden_everywhere": {
    "$comment": "Substrings that must not appear in any workflow file.",
    "patterns": [
      "pull_request_target",
      "::set-output",
      "actions/checkout@v",
      "kubectl",
      "kubeconfig",
      "KUBE_CONFIG",
      "flux reconcile",
      "k3d"
    ],
    "requirement": "FR-006, FR-007, FR-014"
  },
  "action_pins": {
    "$comment": "Every uses: must name a 40-character SHA. The SHAs themselves are deliberately NOT listed: Renovate's github-actions manager moves them, and a contract holding copies would turn every dependency proposal red through no fault of its own (FR-009). The rule below is what actually encodes FR-003.",
    "rule": "^[^@]+@[0-9a-f]{40}( +#.*)?$",
    "requirement": "FR-003"
  },
  "images": {
    "registry": "ghcr.io",
    "services": [
      "flagpole-api",
      "flagpole-consumer",
      "flagpole-web"
    ],
    "tags": [
      "<VERSION>",
      "sha-<short commit>"
    ],
    "requirement": "FR-005",
    "owner_from": "github.repository_owner",
    "$comment": "The owner is never hardcoded: a fork publishes to its own namespace."
  },
  "scanners": [
    {
      "name": "pip-audit",
      "covers": "python dependencies",
      "fails_at": "HIGH"
    },
    {
      "name": "npm audit",
      "covers": "npm dependencies",
      "fails_at": "high"
    },
    {
      "name": "osv-scanner",
      "covers": "all lockfiles",
      "fails_at": "HIGH"
    },
    {
      "name": "trivy",
      "covers": "images and manifests",
      "fails_at": "HIGH"
    },
    {
      "name": "hadolint",
      "covers": "Dockerfiles",
      "fails_at": "error"
    },
    {
      "name": "gitleaks",
      "covers": "secrets in history",
      "fails_at": "any"
    },
    {
      "name": "bandit",
      "covers": "python source",
      "fails_at": "HIGH"
    },
    {
      "name": "semgrep",
      "covers": "python and typescript source",
      "fails_at": "ERROR"
    }
  ],
  "scan_script": {
    "path": "scripts/scan.sh",
    "runs_all_before_failing": true,
    "missing_tool_is_a_failure": true,
    "requirement": "FR-010, FR-011, FR-013"
  },
  "renovate": {
    "path": "renovate.json",
    "managers": [
      "pep621",
      "npm",
      "dockerfile",
      "github-actions",
      "pre-commit",
      "helm-values",
      "flux",
      "kubernetes",
      "mise"
    ],
    "pin_digests": true,
    "automerge": false,
    "forbidden_keys": [
      "fileMatch"
    ],
    "requirement": "FR-008, FR-009"
  },
  "findings_document": {
    "path": "docs/security-findings.md",
    "columns": [
      "Date",
      "Scanner",
      "Identifier",
      "Severity",
      "Where",
      "Decision",
      "Reason"
    ],
    "decisions": [
      "fixed",
      "accepted",
      "not applicable",
      "deferred"
    ],
    "requirement": "FR-012"
  }
}
