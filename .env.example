# Copy to .env (gitignored). Every value here is a non-secret default for LOCAL development.
# Ports: the whole project owns the range below. scripts/ports.sh checks a port is free before anything binds it.
FLAGPOLE_PORT_RANGE=18000-18099
FLAGPOLE_API_PORT=18000
FLAGPOLE_WEB_PORT=18010
FLAGPOLE_CONSUMER_PORT=18020
FLAGPOLE_DEX_PORT=18030
FLAGPOLE_POSTGRES_PORT=18040

# Local dev database (SQLite). The cluster uses PostgreSQL from a SOPS-encrypted Secret.
FLAGPOLE_DATABASE_URL=sqlite:///./flagpole.db

# OIDC (Dex). Dev issuer runs from docker compose on FLAGPOLE_DEX_PORT.
FLAGPOLE_OIDC_ISSUER=http://localhost:18030/dex
FLAGPOLE_OIDC_CLIENT_ID=flagpole-web
# Optional: defaults to "<issuer>/keys"; set only if the provider publishes keys elsewhere.
# FLAGPOLE_OIDC_JWKS_URL=http://localhost:18030/dex/keys

# The consumer (003). It signs its own short-lived token; flagpole-api trusts the public key as a
# second issuer (001 FR-019). Generate the pair with scripts/consumer-keys.sh — never commit it.
FLAGPOLE_CONSUMER_ENV=dev
FLAGPOLE_API_URL=http://localhost:18000
FLAGPOLE_CONSUMER_TIMEOUT_SECONDS=2.0
FLAGPOLE_CONSUMER_KEY_PATH=.keys/service.key
FLAGPOLE_SERVICE_ISSUER=flagpole-consumer
FLAGPOLE_SERVICE_AUDIENCE=flagpole-api
# The API side of the same arrangement (path is relative to backend/). FLAGPOLE_SERVICE_ENV is
# the environment this API serves; a service token minted for the other one is refused.
FLAGPOLE_SERVICE_PUBLIC_KEY_PATH=../consumer/.keys/service.pub
FLAGPOLE_SERVICE_ENV=dev

# The MCP server (004). It signs its own token with its own key pair; flagpole-api is told to treat
# that one issuer as an operator (001 FR-020). Generate the pair with scripts/mcp-keys.sh.
# LOCAL DEVELOPMENT ONLY — the prod overlay never sets the two API settings below.
FLAGPOLE_MCP_ENV=dev
FLAGPOLE_MCP_KEY_PATH=.keys/service.key
FLAGPOLE_MCP_SERVICE_ISSUER=flagpole-mcp
FLAGPOLE_MCP_SERVICE_AUDIENCE=flagpole-api
FLAGPOLE_MCP_TIMEOUT_SECONDS=5.0
# The API side of the operator slot (path is relative to backend/).
FLAGPOLE_OPERATOR_SERVICE_ISSUER=flagpole-mcp
FLAGPOLE_OPERATOR_SERVICE_PUBLIC_KEY_PATH=../mcp/flagpole-mcp/.keys/service.pub

# SOPS/age: the PRIVATE key lives outside the repo. Only the path is configured here.
SOPS_AGE_KEY_FILE=~/.config/sops/age/flagpole.agekey

# k3d and the cluster (005). Ingress is on 80/443 via the k3d load balancer; every other port in
# this file is for the local development stack only and is not used in the cluster.
FLAGPOLE_CLUSTER_NAME=flagpole
FLAGPOLE_IMAGE_REGISTRY=ghcr.io/randaguiac20
FLAGPOLE_IMAGE_TAG=0.1.0
FLAGPOLE_DEV_HOST=dev.flagpole.localhost
FLAGPOLE_PROD_HOST=prod.flagpole.localhost
FLAGPOLE_DEV_CONSUMER_HOST=consumer.dev.flagpole.localhost
FLAGPOLE_PROD_CONSUMER_HOST=consumer.prod.flagpole.localhost
FLAGPOLE_DEX_HOST=dex.flagpole.localhost
