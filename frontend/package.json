{
  "name": "flagpole-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flagpole web UI. Spec: 002-flagpole-web.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../specs/001-flagpole-api/contracts/openapi.yaml -o src/api/schema.d.ts",
    "api:types:check": "openapi-typescript ../specs/001-flagpole-api/contracts/openapi.yaml -o src/api/schema.d.ts --check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
