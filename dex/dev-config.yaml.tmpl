# Dex for LOCAL DEVELOPMENT ONLY. Spec: 002-flagpole-web (research F5).
# The cluster gets the same users through a HelmRelease in feature 005; these credentials are demo
# data, not secrets (the password is "flagpole" and is printed in the quickstart).
# Dex reads a static file, so the ports are substituted from the environment by scripts/dex-config.sh
# into dex/.dev-config.yaml (gitignored), which docker compose mounts. Never edit that copy.
issuer: http://localhost:${FLAGPOLE_DEX_PORT}/dex

storage:
  type: memory

web:
  http: 0.0.0.0:5556
  # CORS for the browser token exchange (/token, /keys, discovery). /auth is a top-level navigation.
  allowedOrigins:
    - http://localhost:${FLAGPOLE_WEB_PORT}

oauth2:
  responseTypes: ["code"]
  skipApprovalScreen: true

staticClients:
  - id: flagpole-web
    name: Flagpole Web
    public: true            # PKCE, no client secret in the browser (FR-001)
    redirectURIs:
      - http://localhost:${FLAGPOLE_WEB_PORT}/callback

enablePasswordDB: true
staticPasswords:
  - email: alice@flagpole.local
    username: alice
    userID: 11111111-1111-1111-1111-111111111111
    hash: "$2b$10$rhJM5jU/ZMJpg9Q6s.DtKOJbW9CWYQmvbyjs74ogk4jXQIrS0Td5i"
    groups: ["operators"]
  - email: bob@flagpole.local
    username: bob
    userID: 22222222-2222-2222-2222-222222222222
    hash: "$2b$10$6zH7Nc4Iy5JMq0ZH9jP07.vM3n2J1FnkNA9.fBvMoRVTmdqmQdoPC"
    groups: ["viewers"]
